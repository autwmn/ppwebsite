Options -MultiViews
RewriteEngine On

# /index.html or /index → /
RewriteCond %{THE_REQUEST} \s/index(\.html)?[\s?]
RewriteRule ^ / [R=301,L]

# /about-us.html → /about-us (redirect old-style URLs to clean ones)
RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Serve about-us.html when /about-us is requested (internal, invisible)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
